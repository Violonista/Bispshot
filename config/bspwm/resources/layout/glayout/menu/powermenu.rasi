configuration {
    show-icons:                 false;
    hover-select:               true;
}

* {
    background-color:           transparent;
    text-color:                 @on-surface;
    font:                       "Fira Code Light 11";
}

window {
    transparency:               "real";
    location:                   north;
    anchor:                     north;
    width:                      80%;
    x-offset:                   0;
    y-offset:                   10;
    background-color:           transparent;
}

mainbox {
    spacing:                    10px;
    children:                   [ "listview" ];
}

listview {
    columns:                    5;
    lines:                      1;
    cycle:                      false;
    dynamic:                    false;
    scrollbar:                  false;
    margin:                     0% 20%;
    layout:                     vertical;
    flow:                       horizontal;
    spacing:                    20px;
    padding:                    10px;
    background-color:           @surface;
    border:                     2px solid;
    border-color:               @outline;
    border-radius:              18px;
}

element {
    orientation:                vertical;
    padding:                    3.5% 0%;
    spacing:                    25px;
    background-color:           @surface-container;
    border:                     2px solid;
    border-color:               @outline;
    border-radius:              12px;
    text-color:                 @on-surface;
    cursor:                     pointer;
    children:                   [ "element-text" ];
}

element-text {
    horizontal-align:           0.5;
    vertical-align:             0.5;
    font:                       "Fira Code Light 14";
    cursor:                     inherit;
}

element normal.normal,
element alternate.normal {
    background-color:           @surface-container;
    border-color:               @outline;
    text-color:                 @outline;
}

element selected.normal,
element selected.active {
    background-color:           @surface;
    border-color:               @primary;
    text-color:                 @on-surface;
}