configuration {
    show-icons:                 false;
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      500px;
    x-offset:                   0px;
    y-offset:                   0px;

    enabled:                    true;
    margin:                     0px;
    padding:                    20px;
    border:                     2px solid;
    border-radius:              0px;
    border-color:               @primary;
    background-color:           @surface;
    cursor:                     "default";
}

mainbox {
    enabled:                    true;
    spacing:                    20px;
    margin:                     0px;
    padding:                    0px;
    border:                     0px solid;
    border-radius:              0px;
    background-color:           transparent;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    enabled:                     true;
    spacing:                     15px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px;
    border-radius:               0px;
    background-color:            transparent;
    text-color:                  @on-surface;
    children:                    [ "prompt"];
}

prompt {
    enabled:                     true;
    padding:                     12px;
    border-radius:               0px;
    background-color:            @primary;
    text-color:                  @surface;
}

listview {
    enabled:                    true;
    columns:                    5;
    lines:                      1;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;

    spacing:                    15px;
    margin:                     6px 0px;
    padding:                    0px;
    border:                     0px solid;
    background-color:           transparent;
    cursor:                     "default";
}

element {
    enabled:                    true;
    border:                     4px 4px 1px 1px solid;
    border-radius:              0px;
    background-color:           @surface;
    text-color:                 @on-surface;
    border-color:               @primary;
    padding:                    25px 10px;
    cursor:                     pointer;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.5;
}

element selected {
    border:                     4px 4px 1px 1px solid;
    border-radius:              0px;
    background-color:           @primary;
    text-color:                 @surface;
    border-color:               transparent;
}