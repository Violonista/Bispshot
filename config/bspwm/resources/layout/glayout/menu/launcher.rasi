configuration {
    modi:                       "drun";
    show-icons:                 true;
    display-drun:               "";
    hover-select:               true;
}

* {
    background-color:           transparent;
    text-color:                 @on-surface;
    font:                       "Fira Code Light 11";
}

window {
    transparency:               "real";
    location:                   north;
    anchor:                     north;
    width:                      80%;
    x-offset:                   0;
    y-offset:                   10;
    border:                     0px solid;
    background-color:           transparent;
}

mainbox {
    spacing:                    10px;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    enabled:                    true;
    margin:                     0% 25%;
    padding:                    8px 10px;
    spacing:                    4px;
    background-color:           @surface;
    border-radius:              6px;
    children:                   [ "prompt", "entry" ];
}

prompt {
    text-color:                 @primary;
    padding:                    10px 14px;
    font:                       "Fira Code Light 12";
}   

entry {
    placeholder:                "Pesquisar...";
    placeholder-color:          @outline;
    background-color:           @surface-container;
    text-color:                 @on-surface;
    border:                     1px solid;
    border-radius:              6px;
    border-color:               @outline;
    padding:                    10px 18px;
    cursor:                     text;
}

listview {
    columns:                    8;
    lines:                      2;
    cycle:                      true;
    dynamic:                    false;
    scrollbar:                  true;
    layout:                     vertical;
    flow:                       horizontal;
    spacing:                    12px;
    padding:                    12px 14px;
    background-color:           @surface;
    border:                     2px solid;
    border-color:               @outline;
    border-radius:              18px;
}

scrollbar {
    handle-width:               4px;
    handle-color:               @primary;
    background-color:           @surface-container;
    cursor:                     pointer;
}

element {
    orientation:                vertical;
    padding:                    12px 20px;
    spacing:                    12px;
    background-color:           @surface-container;
    border:                     2px solid;
    border-color:               @outline;
    border-radius:              12px;
    text-color:                 @on-surface;
    cursor:                     pointer;
}

element-icon {
    size:                       54px;
    horizontal-align:           0.5;
    vertical-align:             0.5;
    cursor:                     inherit;
}

element-text {
    horizontal-align:           0.5;
    vertical-align:             0.5;
    font:                       "Fira Code Light 10";
    cursor:                     inherit;
}

element normal.normal,
element alternate.normal {
    background-color:           @surface-container;
    border-color:               @outline;
    text-color:                 @outline;
}

element selected.normal,
element selected.active {
    background-color:           @surface;
    border-color:               @primary;
    text-color:                 @on-surface;
}