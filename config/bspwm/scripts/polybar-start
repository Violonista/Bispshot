#!/usr/bin/env bash

args=(-c "${BSPWM_RUN}/layout/bar/config.ini")

startPolybar() {
    if ! polybar "${args[@]}" >/dev/null 2>&1; then
        notify-send \
            -u normal \
            --icon="$BSPWM_RES/assets/error.png" \
            "Erro ao iniciar o polybar"
        exit 1
    fi
}

if command -v polybar >/dev/null 2>&1; then
    if pgrep polybar >/dev/null 2>&1; then
        polybar-msg cmd quit
        sleep 1
        startPolybar &
    else
        startPolybar &
    fi
fi
